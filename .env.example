# Variables del gateway. En local las genera `make setup` en un archivo .env (que NO se sube a git).
# Este archivo solo documenta qué existe; no contiene secretos.

# ---------- Servicio de tokens ----------
# Llave privada RSA (PEM en base64). SOLO la tiene el servicio de tokens. Se genera con `make setup` o `make claves`.
JWT_PRIVATE_KEY_B64=
# Clientes: lista JSON con el hash de cada secreto. Se genera con `make setup` o `make cliente`.
CLIENTES_JSON=
JWT_ISSUER=rodar-gateway     # claim «iss»: el gateway rechaza tokens de otro emisor
JWT_AUDIENCE=rodar           # claim «aud»: el gateway rechaza tokens para otra audiencia
TOKEN_TTL_S=900              # vigencia de un token (15 minutos)

# ---------- Gateway (KrakenD) ----------
# Llaves PÚBLICAS con las que se validan los tokens (JWKS). Salen de la misma generación de llaves.
JWKS_JSON=
TOKENS_URL=http://tokens:8000     # el servicio de tokens (interno: no se publica)
LOG_LEVEL=INFO

# Por cada servicio detrás del gateway: su URL y el valor de X-Gateway-Secret que el gateway le envía.
# Si la URL de un servicio no se define, sus rutas quedan desactivadas (así se despliega por partes).
# El secreto debe ser el mismo que el GATEWAY_SECRET configurado en ese servicio.
FLOTA_CRUD_URL=
FLOTA_CRUD_SECRET=
FLOTA_MID_URL=
FLOTA_MID_SECRET=
VIAJES_CRUD_URL=
VIAJES_CRUD_SECRET=
VIAJES_MID_URL=
VIAJES_MID_SECRET=
CUENTAS_CRUD_URL=
CUENTAS_CRUD_SECRET=
CUENTAS_MID_URL=
CUENTAS_MID_SECRET=
