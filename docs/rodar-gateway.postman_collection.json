{
  "info": {
    "name": "Gateway Rodar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generada por make docs desde rutas.json. Ponga baseUrl, clientId y clientSecret y ejecute primero «Pedir token»."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": "administrador"
    },
    {
      "key": "clientSecret",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pedir token (ejecute esta primero)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.access_token) { pm.collectionVariables.set('token', r.access_token); }",
              "pm.test('token emitido', () => pm.expect(r.access_token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "scope",
              "value": "",
              "disabled": true,
              "description": "Opcional: un subconjunto de sus alcances, separados por espacio"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        }
      }
    },
